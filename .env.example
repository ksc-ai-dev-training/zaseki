# ローカル開発用の設定（start.bat が読み込む。コピーして .env を作成）

# DBの動かし方: auto / docker / local
#   auto   … ローカルにPostgreSQLサービスがあればそれを使い、無ければDockerを使う（既定）
#   docker … Dockerコンテナ zaseki-db を使う（Docker Desktopが必要）
#   local  … ローカルインストールしたPostgreSQLサービスを使う（Docker不要）
# このマシンにはKeirekiと共用のローカルPostgreSQLサービスがあり（ポート55432）、
# zaseki用のロール・データベースを作成済みなので、autoでlocalが選ばれる。
DB_MODE=auto

# PostgreSQLの公開ポート。ローカル共用サービスの実際のポート（Keirekiと共通）。
DB_PORT=55432

# DB_MODE=local のときに起動するWindowsサービス名。未設定なら postgresql-* を自動検出
#PG_SERVICE=postgresql-x64-16

# DB_MODE=docker のとき、エンジン未起動なら起動するDocker Desktopのパス（既定から変える場合のみ）
#DOCKER_DESKTOP=C:\Users\<ユーザー名>\AppData\Local\Programs\DockerDesktop\Docker Desktop.exe

# バックエンド（FastAPI/uvicorn）
BACKEND_PORT=8020
# フロントエンド（Vite）。使用中の場合Viteが自動で次の空きポートに割り当てる
FRONTEND_PORT=5180

# ---------------------------------------------------------------------------
# 以下はローカル開発では不要（本番用）
# ---------------------------------------------------------------------------

# 実行環境の識別。production にすると以下が自動で切り替わる:
#   ・開発用ログイン(/api/auth/dev-login, /api/auth/dev-users)を強制無効化
#   ・セッションCookieに Secure 属性を付与
#   ・起動時の自動スキーマ適用(CREATE TABLE)を抑止
#   ・JWT_SECRET 未設定なら起動時にエラー
#APP_ENV=production

# 本番DBの接続文字列（マネージドPostgreSQL。基本設計書1.3節）。
# 末尾に ?sslmode=require を付けること。パスワードに記号が含まれる場合はURLエンコードする。
#DATABASE_URL=postgresql://user:PASSWORD@host:5432/dbname?sslmode=require

# セッションJWTの署名鍵。本番では必須。十分に長いランダム文字列を設定する
#   生成例: python -c "import secrets; print(secrets.token_urlsafe(48))"
#JWT_SECRET=

# Google OAuth（A-01/A-02）。Google Cloud Console で作成したOAuthクライアントの値。
#GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=
# コールバックURL。未設定ならリクエストのホストから自動導出するため通常は不要。
#GOOGLE_REDIRECT_URI=https://<アプリ名>/api/auth/callback
# ログインを許可するメールアドレスのドメイン（要件定義書NFR-01。カンマ区切りで複数可）
#ALLOWED_DOMAINS=kogasoftware.com
